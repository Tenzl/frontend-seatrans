# PUBLIC FRONTEND / VERCEL — mẫu production.
# Điền [BẮT BUỘC] vào Vercel > Settings > Environment Variables > Production.
# Sau khi thay URL: build và deploy lại. File mẫu này không tự được Next.js nạp.

# [BẮT BUỘC] Origin BACKEND HTTPS, không có /api/v1.
# Ví dụ hiện tại: https://backend-seatrans-mqvc.onrender.com
# ĐỔI KHI: đổi domain/host backend. Dùng cùng giá trị ở dashboard_admin.
API_PROXY_TARGET=

# Giữ '/' để browser gọi cùng domain frontend qua proxy /api/*.
# '/' là giá trị chủ ý: code frontend hiện yêu cầu biến này có giá trị.
# Không đổi thành URL Render nếu đang dùng cookie/OAuth qua proxy.
NEXT_PUBLIC_API_BASE_URL=/
NEXT_PUBLIC_API_PREFIX=api
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_API_LOGS=false

# KHI ĐỔI DOMAIN FRONTEND:
# 1. Thêm domain HTTPS mới vào CORS_ORIGINS trên BACKEND.
# 2. Nếu dùng Google: đặt domain này đầu CORS_ORIGINS và đổi GOOGLE_REDIRECT_URI
#    trên backend thành https://DOMAIN-MOI/api/v1/auth/oauth2/callback/google.
# 3. Cập nhật cùng callback trong Google Cloud > Authorized redirect URIs;
#    cập nhật Authorized JavaScript origins nếu OAuth client có cấu hình mục đó.
# Secret database, JWT, Google, R2 và Cloudinary chỉ đặt trên backend.
